apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: kyverno-aggregated-roles
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "5"
spec:
  project: platform
  source:
    repoURL: https://github.com/GHARBIyasmine/kyverno-platform.git
    targetRevision: main
    path: infra/kyverno
    directory:
      include: 'kyverno-cluster-role.yaml'
  destination:
    server: https://kubernetes.default.svc
    namespace: kyverno # ignored because the resource is cluster-scoped 